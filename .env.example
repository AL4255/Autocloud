# AutoCloud Environment Variables

# Required: Anthropic API Key for Claude
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Optional: Azure Subscription ID (can be obtained from az CLI if not set)
AZURE_SUBSCRIPTION_ID=your-subscription-id-here

# Optional: Override default AutoCloud home directory
# AUTOCLOUD_HOME=/custom/path/to/autocloud

# Optional: Default Azure region
# AZURE_DEFAULT_REGION=eastus

# Optional: Enable debug logging
# AUTOCLOUD_DEBUG=true
